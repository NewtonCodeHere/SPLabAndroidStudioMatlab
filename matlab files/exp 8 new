clc;
clear;
close all;

x=[zeros(1,100) ones(1,150) -ones(1,100) ones(1,150) -ones(1,100)];

L=[3 10 51];

figure;
subplot(4,1,1);
plot(x);
title('Input Signal');
xlabel('Sample');
ylabel('Amplitude');
grid on;

for i=1:3
    b=ones(1,L(i))/L(i);
    y=filter(b,1,x);

    subplot(4,1,i+1);
    plot(y);
    title(['Moving Average L = ' num2str(L(i))]);
    xlabel('Sample');
    ylabel('Amplitude');
    grid on;
end

subplot(4,1,4);
xline(300,'b','LineWidth',1.5);
